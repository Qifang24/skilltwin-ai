# SkillTwin AI —— 环境变量样例
#
#   cp .env.example .env      ← 真实 Key 填进 .env，不要填这里
#
# ╔══════════════════════════════════════════════════════════════╗
# ║ ⚠️ 本文件会被提交到 git（.gitignore 里对它做了白名单例外）。      ║
# ║    只允许出现占位符，任何真实 Key 写在这里都等于公开泄露。        ║
# ║    需要改配置请改 .env —— 那个文件已被 git 忽略。               ║
# ╚══════════════════════════════════════════════════════════════╝

# ==================== 应用 ====================
DEBUG=false
LOG_LEVEL=INFO
# 前端开发服务器地址，逗号分隔的 JSON 数组
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ==================== Docker / Production ====================
# docker compose uses a same-origin Nginx proxy by default. Before publishing,
# replace CORS_ORIGINS with the actual HTTPS domain if the API will also be called directly.
# CORS_ORIGINS=["http://localhost:8080","https://your-domain.example"]
SKILLTWIN_PORT=8080
# First container boot loads core seed data; enabling the RAG index additionally downloads
# the embedding model if it is absent and may take several minutes.
BOOTSTRAP_ON_START=true
BUILD_RAG_INDEX_ON_START=true

# ==================== 数据库 ====================
# 留空则自动使用 data/skilltwin.db
# DATABASE_URL=sqlite:///C:/path/to/skilltwin.db

# ==================== LLM ====================
# live   = 正常调用远端模型
# record = 正常调用并把结果存入 llm_run，供日后回放
# replay = 只从 llm_run 缓存回放，不发网络请求（断网演示用）
DEMO_MODE=live

# openai_compat | spark | xingchen_workflow | echo
LLM_PROVIDER=openai_compat

# ---- DeepSeek ----
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-your-key-here

# ---- 阿里云百炼 / 通义千问（可选，取消注释即切换）----
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=sk-your-key-here

# ---- OpenRouter（可选）----
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-chat
LLM_API_KEY=your-llm-api-key-here

LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# ---- 科大讯飞星火 HTTP / OpenAI-compatible API（Phase 18）----
# 讯飞 HTTP 接口使用控制台提供的 APIPassword；不要与 WebSocket APIKey/APISecret 混用。
# LLM_PROVIDER=spark
# SPARK_BASE_URL=https://spark-api-open.xf-yun.com/v1
# SPARK_MODEL=4.0Ultra
SPARK_API_PASSWORD=

# ---- 科大讯飞星辰 Agent Workflow OpenAPI（Phase 18，可选）----
# 先在星火智能体创作中心创建、调试并发布工作流；起始节点参数名需与下方一致。
# LLM_PROVIDER=xingchen_workflow
# XINGCHEN_FLOW_ID=
# XINGCHEN_API_KEY=
# XINGCHEN_API_SECRET=
# XINGCHEN_INPUT_PARAMETER=AGENT_USER_INPUT
# XINGCHEN_UID=skilltwin-demo

# ---- 旧版星火 WebSocket 凭证（本项目当前 HTTP Provider 不读取）----
SPARK_APP_ID=
SPARK_API_KEY=
SPARK_API_SECRET=

# ==================== Embedding ====================
# local_bge      = 本地 sentence-transformers，免 Key、可离线、支持 GPU（推荐）
# openai_compat  = 走 API（注意：DeepSeek 没有 embedding 接口，需用通义等）
# hash           = 仅供测试的确定性伪向量，禁止用于生产
EMBEDDING_PROVIDER=local_bge
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# auto | cuda | cpu
EMBEDDING_DEVICE=auto
EMBEDDING_DIM=512
EMBEDDING_BATCH_SIZE=32

# ==================== RAG 检索 ====================
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVE_DENSE_TOP_K=20
RETRIEVE_SPARSE_TOP_K=20
RETRIEVE_FINAL_TOP_N=8
RRF_K=60
